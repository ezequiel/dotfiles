{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "update": "disable",
  "snapshots": false,
  "default_agent": "plan",
  "instructions": [
    "{env:XDG_CONFIG_HOME}/opencode/stuff/linus-torvalds.md",
    "{env:XDG_CONFIG_HOME}/opencode/stuff/ponytail.md",
    "{env:XDG_CONFIG_HOME}/opencode/stuff/simple-english.md",
    "{env:XDG_CONFIG_HOME}/opencode/stuff/opensrc.md"
  ],
  "permissions": [
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "chrome-devtools-mcp",
          "--no-usage-statistics",
          "--browser-url=http://127.0.0.1:9333"
        ],
        "disabled": false,
        "timeout": {
          "startup": 45000
        }
      }
    }
  }
}
