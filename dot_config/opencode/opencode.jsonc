{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "permission": {
    "bash": {
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "rm -rf *": "ask"
    }
  },
  "autoupdate": false,
  "instructions": [
    "{env:XDG_CONFIG_HOME}/opencode/stuff/linus-torvalds.md",
    "{env:XDG_CONFIG_HOME}/opencode/stuff/ponytail.md",
    "{env:XDG_CONFIG_HOME}/opencode/stuff/simple-english.md"
  ],
  "default_agent": "plan",
  "experimental": {
    "openTelemetry": false
  },
  "share": "disabled",
  "snapshot": false,
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics"
      ],
      "enabled": true
    }
  }
}
