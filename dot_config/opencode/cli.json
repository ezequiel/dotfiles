{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["./plugins/hide-footer", "./herdr-opencode"],
  "theme": {
    "name": "tokyonight"
  },
  "mouse": false,
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "view": "auto"
  },
  "tabs": {
    "scope": "global"
  },
  "keybinds": {
    "leader": "\\",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "app.exit": "ctrl+c,<leader>q",
    "command.palette.show": "<leader>c",
    "session.compact": "none",
    "session.interrupt": "escape",
    "model.list": "<leader>m",
    "session.list": "<leader>l",
    "session.new": "<leader>n",
    "session.rename": "<leader>r",
    "session.redo": "none",
    "messages.copy": "<leader>y",
    "session.message.next": "alt+j",
    "session.message.previous": "alt+k",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.first": "ctrl+shift+g",
    "session.last": "ctrl+g",
    "session.line.up": "ctrl+p",
    "session.line.down": "ctrl+n",
    "prompt.history.previous": "up",
    "prompt.history.next": "down",
    "input.undo": "ctrl+z",
    "input.redo": "ctrl+shift+z",
    "terminal.suspend": "none",
    "terminal.title.toggle": "none"
  }
}
