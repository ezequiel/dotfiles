alias vi='nvim'

wt() {
  local branch="$1"
  if [[ "$branch" == <-> || "$branch" == \#<-> || "$branch" == https://*/pull/<->* ]]; then
    branch=$(gh pr view "${branch#\#}" --json headRefName --jq .headRefName) || return 1
  fi
  local repo_root
  repo_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  git -C "$repo_root" fetch origin "$branch" || return 1
  # herdr's base from ~/.config/herdr/config.toml [worktrees].directory — must match its slug rule (lowercase, / -> -)
  local expected_path="$HOME/Projects/worktrees/${repo_root:t}/${${branch//\//-}:l}"
  local list
  list=$(git worktree list --porcelain)
  local wt_path
  wt_path=$(print -r -- "$list" | awk -v branch="refs/heads/$branch" '/^worktree /{path=substr($0,10)} $0=="branch " branch {print path; exit}')
  if [[ -n "$wt_path" ]]; then
    [[ "$wt_path" != "$expected_path" ]] &&
      echo "wt: note: $branch lives at $wt_path (expected $expected_path)"
    local wt_head origin_head
    wt_head=$(git -C "$wt_path" rev-parse HEAD)
    origin_head=$(git rev-parse origin/"$branch")
    if ! git -C "$wt_path" diff --quiet || ! git -C "$wt_path" diff --cached --quiet || [[ "$wt_head" != "$origin_head" ]]; then
      echo "wt: $wt_path has uncommitted changes"
      echo -n "  [o] overwrite  [a] abort > "
      read -rk1 choice
      echo
      [[ "$choice" != "o" ]] && return 1
    fi
    git -C "$wt_path" reset --hard origin/"$branch" &&
    herdr worktree open --cwd "$repo_root" --path "$wt_path"
  else
    if [[ -e "$expected_path" ]]; then
      echo "wt: $expected_path exists but $branch isn't checked out there; remove it or pick another branch name" >&2
      print -r -- "$list" | awk -v p="$expected_path" '$0=="worktree "p{found=1} found&&/^branch /{print "wt: it currently holds " $2; exit}' >&2
      return 1
    fi
    git -C "$repo_root" branch -f "$branch" origin/"$branch" &&
    herdr worktree create --cwd "$repo_root" --branch "$branch" --path "$expected_path" || return 1
    # herdr guesses when not nailed down; verify it didn't squat on a sibling directory anyway
    local actual
    actual=$(git worktree list --porcelain | awk -v branch="refs/heads/$branch" '/^worktree /{path=substr($0,10)} $0=="branch " branch {print path; exit}')
    [[ -n "$actual" && "$actual" != "$expected_path" ]] &&
      echo "wt: WARNING: herdr put $branch at $actual, not $expected_path" >&2
  fi
}

# Remove worktrees + local branches proven merged into the base branch.
# Base = the arg if given, else the repo's default branch (origin/HEAD,
# resolved with `git remote set-head origin -a` when unset).
# "Proven" = ancestor of origin/<base>, or a merged GitHub PR into <base>
# (covers squash merges). Skips dirty worktrees, detached HEADs, the main
# checkout, the cwd, and anything unproven. Closes open herdr sessions of
# removed worktrees.
# Usage: purge [-a|--all] [base]
#   purge         current repo only
#   purge --all   every worktree under ~/Projects/worktrees, grouped by
#                 parent repo (override root with $PURGE_WORKTREE_ROOT)
purge() {
  local all=0 base_override=""
  local arg
  for arg in "$@"; do
    case $arg in
      -a|--all) all=1 ;;
      *) base_override=$arg ;;
    esac
  done

  # herdr sessions keyed by checkout path (spans all repos, built once)
  local -A ws
  local line
  for line in ${(f)"$(herdr workspace list 2>/dev/null | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for w in d["result"]["workspaces"]:
    p=(w.get("worktree") or {}).get("checkout_path")
    if p: print(p+"\t"+w["workspace_id"])')"}; do
    ws[${line%%$'\t'*}]=${line##*$'\t'}
  done

  # per-repo context, (re)set by purge_repo; zsh dynamic scoping lets the
  # helpers below see these
  local _repo _b _tip
  local -A merged_pr _resolved_base

  # fetch, resolve base, load merged PRs for repo $1; sets _repo/_b/merged_pr
  purge_repo() {
    _repo=$1
    _b=$base_override
    if [[ -z $_b ]]; then
      _b=${_resolved_base[$_repo]-}
      if [[ -z $_b ]]; then
        _b=$(git -C "$_repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
        if [[ -z $_b ]]; then
          git -C "$_repo" remote set-head origin -a >/dev/null 2>&1
          _b=$(git -C "$_repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
        fi
        _b=${_b#origin/}
        [[ -z $_b ]] && { echo "skip  $_repo (no default branch found)"; return 1; }
        _resolved_base[$_repo]=$_b
      fi
    fi
    git -C "$_repo" rev-parse --verify --quiet "refs/remotes/origin/$_b" >/dev/null ||
      { echo "skip  ${_repo#$HOME/} (no origin/$_b)"; return 1; }
    git -C "$_repo" fetch origin --prune || return 1

    local url host_path
    url=${$(git -C "$_repo" remote get-url origin)%.git}
    if [[ $url == *://* ]]; then host_path=${url#*://}; else host_path=${${url#*@}/:/\/}; fi

    merged_pr=()
    local b
    for b in ${(f)"$(gh pr list -R "$host_path" --state merged --search "base:$_b" --limit 1000 --json headRefName --jq '.[].headRefName' 2>/dev/null)"}; do
      [[ -n $b ]] && merged_pr[$b]=1
    done
    echo "repo  ${_repo#$HOME/} (base=$_b)"
  }

  _merged() { git -C "$_repo" merge-base --is-ancestor "$1" "origin/$_b" 2>/dev/null && return 0; [[ -n ${merged_pr[$2]-} ]]; }

  # $1 = optional: only worktrees under this directory
  purge_worktrees() {
    local wtpath bref branch
    git -C "$_repo" worktree list --porcelain | awk '/^worktree /{p=substr($0,10)} /^branch /{print p "\t" substr($0,8)}' |
    while IFS=$'\t' read -r wtpath bref; do
      [[ $wtpath == "$_repo" || $wtpath == "$PWD" || ${PWD#$wtpath/} != "$PWD" ]] && continue
      (( $#1 )) && [[ ${wtpath#$1/} == "$wtpath" ]] && continue
      branch=${bref#refs/heads/}
      _tip=$(git -C "$wtpath" rev-parse HEAD) || continue
      if ! _merged "$_tip" "$branch"; then
        echo "keep  $branch (not proven merged)"
        continue
      fi
      if [[ -n $(git -C "$wtpath" status --porcelain) ]]; then
        echo "skip  $branch (dirty: $wtpath)"
        continue
      fi
      [[ -n ${ws[$wtpath]-} ]] && { herdr workspace close "${ws[$wtpath]}" >/dev/null 2>&1 && echo "close session ${ws[$wtpath]}"; }
      git -C "$_repo" worktree remove "$wtpath" &&
        echo "remove worktree $wtpath ($branch)"
      git -C "$_repo" branch -D "$branch"
    done
  }

  purge_branches() {
    local _t b
    git -C "$_repo" for-each-ref --format='%(refname:short)' refs/heads/ |
    while read -r b; do
      [[ $b == "$_b" ]] && continue
      _t=$(git -C "$_repo" rev-parse "refs/heads/$b" 2>/dev/null) || continue
      if _merged "$_t" "$b" && git -C "$_repo" branch -D "$b" >/dev/null 2>&1; then
        echo "delete branch $b"
      fi
    done
  }

  if (( ! all )); then
    local repo_root
    repo_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)") || return 1
    repo_root=$(git -C "$repo_root" rev-parse --show-toplevel)
    purge_repo "$repo_root" || return 1
    purge_worktrees
    purge_branches
    echo "purge: done (base=$_b)"
    unfunction purge_repo purge_worktrees purge_branches _merged
    return
  fi

  # herdr's [worktrees].directory — same root wt() builds paths from
  local root="${PURGE_WORKTREE_ROOT:-$HOME/Projects/worktrees}"
  local -A repos
  local d parent
  for d in "$root"/*/*(N/); do
    if git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
      parent=$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
        parent=$(git -C "${parent:h}" rev-parse --show-toplevel 2>/dev/null)
      if [[ -n $parent ]]; then
        repos[$parent]=1
      else
        echo "skip  $d (parent repo gone)"
      fi
    else
      echo "skip  $d (not a git worktree)"
    fi
  done

  local r
  for r in ${(ko)repos}; do
    purge_repo "$r" || continue
    purge_worktrees "$root"
    purge_branches
  done

  local slug
  for slug in "$root"/*(N/); do
    rmdir "$slug" 2>/dev/null && echo "rmdir $slug"
  done
  echo "purge: done (all repos)"
  unfunction purge_repo purge_worktrees purge_branches _merged
}

# Find OpenCode sessions by PR number or text. Reopen one with: opencode -s <id>
ocs() {
  [[ -z "$1" ]] && { echo "usage: ocs <pr#|text>" >&2; return 1; }
  local q=${1//\'/\'\'} msg
  if [[ "$1" == <-> ]]; then msg="/pull/$1"; else msg=$q; fi
  sqlite3 -readonly -separator '  ' "$(opencode debug paths db)" "
    SELECT date(s.time_created/1000, 'unixepoch', 'localtime'), s.id, replace(s.directory, '$HOME', '~'), s.title
    FROM session_v2 s
    WHERE s.parent_id IS NULL AND (s.title LIKE '%$q%' OR EXISTS (
      SELECT 1 FROM session_message m
      WHERE m.session_id = s.id AND m.type = 'user' AND m.data LIKE '%$msg%'))
    ORDER BY s.time_created DESC LIMIT 20;"
}


# rename herdr workspace to current directory on cd (no-op outside herdr)
_herdr_chpwd() {
  [[ -z "$HERDR_ENV" || -z "$HERDR_WORKSPACE_ID" ]] && return
  local dir="${PWD/#$HOME/~}"
  "${HERDR_BIN_PATH:-herdr}" workspace rename "$HERDR_WORKSPACE_ID" "$dir" >/dev/null 2>&1 &!
}
add-zsh-hook chpwd _herdr_chpwd

# kitty sends fake CSI on ctrl+shift+l (not ^L — herdr-nvim-nav owns \x0c in nvim)
bindkey '\e[999~' clear-screen

